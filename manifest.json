{
  "manifest_version": 3,
  "name": "Gmail Message Link",
  "version": "0.1.0",
  "description": "Copy IDs that let AI agents open the Gmail message you are viewing.",
  "permissions": ["clipboardWrite"],
  "action": {
    "default_title": "Copy Gmail message IDs",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
